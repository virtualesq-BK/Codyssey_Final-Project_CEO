# LLM Provider 설정
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini          # copa.codyssey.kr 엔드포인트 사용 시. 표준 OpenAI는 gpt-4o-mini
OPENAI_BASE_URL=              # 커스텀 엔드포인트 URL (없으면 공란)

# API Keys (실제 .env에만 입력, commit 금지)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=sqlite+aiosqlite:///./nadosajang.db

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── bizrag (B팀 RAG) 설정 ──────────────────────────────────────────────
# DB 경로: bizrag가 수집한 지식 DB. backend/rag/ 에서 python -m bizrag sync 실행 후 생성됨
BIZRAG_DB_PATH=../rag/data/knowledge.db

# 네이버 API HUB (https://api.naver.com) — 검색트렌드·쇼핑키워드
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 통계청 KOSIS (https://kosis.kr/openapi) — 무료 회원가입 후 발급
KOSIS_API_KEY=

# 법제처 국가법령정보 (https://open.law.go.kr) — 가입 이메일의 @ 앞부분
LAW_OC=

# KIPRIS 특허정보 (https://www.kipris.or.kr/openapi) — 특허 검색
KIPRIS_API_KEY=

# 공공데이터포털 (https://www.data.go.kr) — 창업공고 실데이터 연동 (api_catalog sync)
DATA_GO_KR_SERVICE_KEY=
