# bizrag API 키 — 이 파일을 .env로 복사해 값을 넣으세요 (.env는 커밋 금지)
# 비어 있는 키의 소스는 건너뜁니다. 점검: python -m bizrag check

# 네이버 NAVER API HUB 앱의 Client ID/Secret (https://console.ncloud.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# KOSIS 국가통계포털 (https://kosis.kr/openapi/)
KOSIS_API_KEY=

# 한국은행 ECOS 경제통계 Open API (https://ecos.bok.or.kr/api/ > 인증키 신청)
BOK_API_KEY=

# 국가법령정보 OPEN API: 가입 이메일의 @ 앞부분 (https://open.law.go.kr, 이 PC의 공인 IP 등록 필요)
LAW_OC=

# KIPRIS Plus (https://plus.kipris.or.kr)
KIPRIS_API_KEY=

# 공공데이터포털 일반 인증키(Decoding) (https://www.data.go.kr)
DATA_GO_KR_SERVICE_KEY=

# ── Pinecone Vector RAG (https://pinecone.io) ────────────────────────
# Pinecone 콘솔 > API Keys에서 발급
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bizrag-market
PINECONE_NAMESPACE=bizrag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── 임베딩 모델 (OpenAI / Gemini) ────────────────────────────────────
# EMBEDDING_PROVIDER: openai (기본값) | gemini | mock
EMBEDDING_PROVIDER=openai
# openai: text-embedding-3-small (1536차원, 기본값) | text-embedding-3-large
# gemini: text-embedding-004 (768차원)
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# GEMINI_API_KEY=
